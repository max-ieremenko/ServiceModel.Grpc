    <description>The Microsoft Test Platform Object Model.</description>
    <copyright>© Microsoft Corporation. All rights reserved.</copyright>
    <tags>vstest visual-studio unittest testplatform mstest microsoft test testing</tags>
    <serviceable>true</serviceable>
    <repository type="git" url="https://github.com/microsoft/vstest" branch="18.9" commit="2b12a89cee3798c4ab3fd301e384d1bd5532f9de" />
    <dependencies>
      <group targetFramework=".NETFramework4.6.2">
        <dependency id="System.Collections.Immutable" version="10.0.0" exclude="Build,Analyzers" />
        <dependency id="System.Reflection.Metadata" version="8.0.0" exclude="Build,Analyzers" />
        <dependency id="System.ValueTuple" version="4.5.0" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0" />
      <group targetFramework=".NETStandard2.0">
        <dependency id="System.Reflection.Metadata" version="8.0.0" exclude="Build,Analyzers" />
      </group>
    </dependencies>
    <frameworkAssemblies>
      <frameworkAssembly assemblyName="Microsoft.CSharp" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System.IO" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System.Runtime" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System.Runtime.Serialization" targetFramework=".NETFramework4.6.2" />
      <frameworkAssembly assemblyName="System.Xml" targetFramework=".NETFramework4.6.2" />
    </frameworkAssemblies>
  </metadata>
</package>